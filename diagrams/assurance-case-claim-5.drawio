wrap;html=1;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="588" y="1007" width="130" height="130" as="geometry"/></mxCell><mxCell id="n20" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d3d3d3;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="638" y="1157" width="30" height="30" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Rebuttal R5.4:&lt;/b&gt; Unless the deployed release predates the DN-check fix" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="822" y="538" width="190" height="82" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Sub-Claim C5.5:&lt;/b&gt;&lt;br&gt;The deployed Keycloak release includes the CVE-2026-19608 fix" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="822" y="668" width="190" height="100" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Evidence E5.6:&lt;/b&gt;&lt;br&gt;CVE-2026-19608 security advisory" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="774" y="816" width="130" height="130" as="geometry"/></mxCell><mxCell id="n24" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d3d3d3;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="824" y="966" width="30" height="30" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Evidence E5.7:&lt;/b&gt;&lt;br&gt;Deployed Keycloak version record" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="816" width="130" height="130" as="geometry"/></mxCell><mxCell id="n26" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d3d3d3;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="966" width="30" height="30" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;Reb