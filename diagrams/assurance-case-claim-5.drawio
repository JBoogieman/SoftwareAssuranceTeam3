<mxfile host="app.diagrams.net"><diagram name="Claim 5" id="claim5"><mxGraphModel dx="2146" dy="1217" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2146" pageHeight="1217" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="&lt;b&gt;Top-Claim C5:&lt;/b&gt;&lt;br&gt;Keycloak grants federated Active Directory users only the realm roles their legitimate directory group memberships authorize" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="957" y="80" width="232" height="112" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Rebuttal R5.1:&lt;/b&gt; Unless federation traffic is altered in transit" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="186" y="260" width="190" height="82" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Sub-Claim C5.1:&lt;/b&gt;&lt;br&gt;Every federation connection is encrypted and authenticated to the genuine directory server" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="186" y="390" width="190" height="100" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Evidence E5.1:&lt;/b&gt;&lt;br&gt;Federation provider TLS configuration scan results" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="538" width="130" height="130" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Undermine UM5.1:&lt;/b&gt; Unless providers added after the scan use plaintext ldap://" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#A9C4EB;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="716" width="190" height="95" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Sub-Claim C5.3:&lt;/b&gt;&lt;br&gt;The TLS scan covers every 