<mxfile host="app.diagrams.net">
  <diagram id="ldap-federation" name="LDAP Federation Use-Misuse">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System boundary -->
        <mxCell id="boundary" value="Keycloak – LDAP User Federation Subsystem" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="260" y="30" width="640" height="830" as="geometry" />
        </mxCell>

        <!-- Actor -->
        <mxCell id="actor" value="Directory Service&lt;br&gt;(Active Directory / LDAP)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="95" y="280" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- Use cases -->
