ValueOfguidanyType></Lines><Zoom>0.5</Zoom></DrawingSurfaceModel></DrawingSurfaceList><MetaInformation><Assumptions/><Contributors/><ExternalDependencies/><HighLevelSystemDescription/><Owner/><Reviewer/><ThreatModelName/></MetaInformation><Notes/><ThreatInstances xmlns:a="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S3c0f3289b-e983-4773-b26c-04d33fe11d584a372f5c-247e-4418-8453-0d4461508c4cfaad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4a372f5c-247e-4418-8453-0d4461508c4c</b:FlowGuid><b:Id>172</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:4a372f5c-247e-4418-8453-0d4461508c4c:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the End user (browser) External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>End user (browser) may be spoofed by an attacker and this may lead to unauthorized access to Authenticate user. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The browser does not identify anyone by itself; Authenticate user establishes the user's identity through the login flow (Interaction 1). For this flow the parameters that matter are client_id and redirect_uri: Keycloak checks redirect_uri against the client's registered values, and PKCE (S256, required through the pkce-enforcer client policy) binds the code to whoever started the flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.1c0f3289b-e983-4773-b26c-04d33fe11d584a372f5c-247e-4418-8453-0d4461508c4cfaad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4a372f5c-247e-4418-8453-0d4461508c4c</b:FlowGuid><b:Id>1</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:4a372f5c-247e-4418-8453-0d4461508c4c:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Authenticate user' could be a subject to a cross-site scripting attack because it does not sanitize untrusted input.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Login and broker pages are FreeMarker templates rendered with HTML auto-escaping (DefaultFreeMarkerProvider sets HTMLOutputFormat). Keycloak has shipped XSS fixes for these pages before, so stay on patched releases.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5c0f3289b-e983-4773-b26c-04d33fe11d584a372f5c-247e-4418-8453-0d4461508c4cfaad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4a372f5c-247e-4418-8453-0d4461508c4c</b:FlowGuid><b:Id>2</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:4a372f5c-247e-4418-8453-0d4461508c4c:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Authenticate user may be able to impersonate the context of End user (browser) in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The authorization request grants nothing until the user authenticates. Requested scopes are limited to the client scopes assigned to the client, and Full Scope Allowed is turned off (full-scope-disabled client policy) so tokens carry only the client's role scope mappings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S33bba3f71-e38e-4f23-9dc9-978f379ee727c308f42b-1abc-4b15-9b02-63e25c3fb378abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>c308f42b-1abc-4b15-9b02-63e25c3fb378</b:FlowGuid><b:Id>3</b:Id><b:InteractionKey>3bba3f71-e38e-4f23-9dc9-978f379ee727:c308f42b-1abc-4b15-9b02-63e25c3fb378:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Client application External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Client application may be spoofed by an attacker and this may lead to unauthorized access to Issue tokens. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Confidential clients authenticate at the token endpoint (client secret by default; we require signed JWT or mTLS). Public clients cannot authenticate, so PKCE S256 is required for them through the pkce-enforcer client policy (off by default), and redirect_uri must match the one used in the authorization request.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3bba3f71-e38e-4f23-9dc9-978f379ee727</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.13bba3f71-e38e-4f23-9dc9-978f379ee727c308f42b-1abc-4b15-9b02-63e25c3fb378abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>c308f42b-1abc-4b15-9b02-63e25c3fb378</b:FlowGuid><b:Id>4</b:Id><b:InteractionKey>3bba3f71-e38e-4f23-9dc9-978f379ee727:c308f42b-1abc-4b15-9b02-63e25c3fb378:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Issue tokens' could be a subject to a cross-site scripting attack because it does not sanitize untrusted input.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Issue tokens is a back-channel JSON endpoint and renders no HTML, so cross-site scripting does not apply to this flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3bba3f71-e38e-4f23-9dc9-978f379ee727</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E53bba3f71-e38e-4f23-9dc9-978f379ee727c308f42b-1abc-4b15-9b02-63e25c3fb378abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>c308f42b-1abc-4b15-9b02-63e25c3fb378</b:FlowGuid><b:Id>5</b:Id><b:InteractionKey>3bba3f71-e38e-4f23-9dc9-978f379ee727:c308f42b-1abc-4b15-9b02-63e25c3fb378:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issue tokens may be able to impersonate the context of Client application in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>A stolen refresh token lets an attacker act as the client. Mitigations: Revoke Refresh Token with Refresh Token Max Reuse 0 (realm-wide, off by default), DPoP binding for public clients, and short access tokens. Gap: Keycloak rejects a reused refresh token as stale but does not revoke the still-active token chain (SR-3.6), so a thief who refreshes first keeps access until the session ends.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3bba3f71-e38e-4f23-9dc9-978f379ee727</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2078cb915-58f8-45a4-81e1-ec4581c8944f1d29761c-e4c6-4477-93f7-3c96a4899b8f72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>1d29761c-e4c6-4477-93f7-3c96a4899b8f</b:FlowGuid><b:Id>73</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:1d29761c-e4c6-4477-93f7-3c96a4899b8f:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for Broker external login or Event store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Broker external login or Event store take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Saved events have a configurable expiration, which bounds table growth; the SIEM keeps the long-term copy.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T7078cb915-58f8-45a4-81e1-ec4581c8944f1d29761c-e4c6-4477-93f7-3c96a4899b8f72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>1d29761c-e4c6-4477-93f7-3c96a4899b8f</b:FlowGuid><b:Id>72</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:1d29761c-e4c6-4477-93f7-3c96a4899b8f:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for Event store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak writes events through JPA/Hibernate with bound parameters, so request details are stored as values, not SQL.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S769efece0-b5eb-43d2-9b89-de620ea514d968315d65-888b-4581-8cae-ef6f646fc622078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>68315d65-888b-4581-8cae-ef6f646fc622</b:FlowGuid><b:Id>57</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:68315d65-888b-4581-8cae-ef6f646fc622:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store Keycloak database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Keycloak database may be spoofed by an attacker and this may lead to incorrect data delivered to Broker external login. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak reaches its database over the configured JDBC connection with a dedicated database account. Restrict that account to the Keycloak schema, require TLS with certificate validation on the JDBC URL (Keycloak does not enforce it), and keep the database on a segment only Keycloak nodes can reach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Identity provider configuration and mappers</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I2369efece0-b5eb-43d2-9b89-de620ea514d9f06d176c-c6c2-41ba-bb1f-5658919d66d9abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>f06d176c-c6c2-41ba-bb1f-5658919d66d9</b:FlowGuid><b:Id>56</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:f06d176c-c6c2-41ba-bb1f-5658919d66d9:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of Keycloak database can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Largest gap in Interaction 3. The database holds client secrets as entered (compared directly, not hashed) unless they are vault references, plus each realm's generated signing keys, including the HMAC key that signs refresh tokens. Read access to the database is enough to forge tokens. Mitigations: vault references for client secrets, the java-keystore key provider instead of generated keys, restricted and audited database access, and encryption at rest.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client registration and signing keys</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.269efece0-b5eb-43d2-9b89-de620ea514d9f06d176c-c6c2-41ba-bb1f-5658919d66d9abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>f06d176c-c6c2-41ba-bb1f-5658919d66d9</b:FlowGuid><b:Id>55</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:f06d176c-c6c2-41ba-bb1f-5658919d66d9:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Persistent Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Issue tokens' could be a subject to a persistent cross-site scripting attack because it does not sanitize data store 'Keycloak database' inputs and output.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Issue tokens is a back-channel JSON endpoint and renders no HTML, so cross-site scripting does not apply to this flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client registration and signing keys</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.169efece0-b5eb-43d2-9b89-de620ea514d9f06d176c-c6c2-41ba-bb1f-5658919d66d9abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>f06d176c-c6c2-41ba-bb1f-5658919d66d9</b:FlowGuid><b:Id>54</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:f06d176c-c6c2-41ba-bb1f-5658919d66d9:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Issue tokens' could be a subject to a cross-site scripting attack because it does not sanitize untrusted input.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Issue tokens is a back-channel JSON endpoint and renders no HTML, so cross-site scripting does not apply to this flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client registration and signing keys</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S769efece0-b5eb-43d2-9b89-de620ea514d9f06d176c-c6c2-41ba-bb1f-5658919d66d9abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>f06d176c-c6c2-41ba-bb1f-5658919d66d9</b:FlowGuid><b:Id>53</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:f06d176c-c6c2-41ba-bb1f-5658919d66d9:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store Keycloak database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Keycloak database may be spoofed by an attacker and this may lead to incorrect data delivered to Issue tokens. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak reaches its database over the configured JDBC connection with a dedicated database account. Restrict that account to the Keycloak schema, require TLS with certificate validation on the JDBC URL (Keycloak does not enforce it), and keep the database on a segment only Keycloak nodes can reach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client registration and signing keys</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I23845efa87-110e-4ad5-a2ea-a0a90d024814b36ca88a-a70d-4491-9da2-1982de6cb55eabb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b36ca88a-a70d-4491-9da2-1982de6cb55e</b:FlowGuid><b:Id>52</b:Id><b:InteractionKey>845efa87-110e-4ad5-a2ea-a0a90d024814:b36ca88a-a70d-4491-9da2-1982de6cb55e:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of Session store can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Session data is reachable only through Keycloak; database and cache access are limited to Keycloak nodes. Codes are removed when redeemed, so a record cannot be read and reused.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Code record and client session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1078cb915-58f8-45a4-81e1-ec4581c8944f1d29761c-e4c6-4477-93f7-3c96a4899b8f72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>1d29761c-e4c6-4477-93f7-3c96a4899b8f</b:FlowGuid><b:Id>71</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:1d29761c-e4c6-4477-93f7-3c96a4899b8f:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store Event store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Event store may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of Event store. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The event store is the event table in the Keycloak database, written only when Save events is on. Keycloak reaches its database over the configured JDBC connection with a dedicated database account. Restrict that account to the Keycloak schema, require TLS with certificate validation on the JDBC URL (Keycloak does not enforce it), and keep the database on a segment only Keycloak nodes can reach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I2369efece0-b5eb-43d2-9b89-de620ea514d9b98fd154-fd9a-4db6-b673-eddcd4007b14faad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b98fd154-fd9a-4db6-b673-eddcd4007b14</b:FlowGuid><b:Id>70</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:b98fd154-fd9a-4db6-b673-eddcd4007b14:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of Keycloak database can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Holds password hashes, OTP secrets (Interaction 1) and each client's registered redirect URIs. Access is limited to the Keycloak database account and database administrators.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>User credentials and client registration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.269efece0-b5eb-43d2-9b89-de620ea514d9b98fd154-fd9a-4db6-b673-eddcd4007b14faad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b98fd154-fd9a-4db6-b673-eddcd4007b14</b:FlowGuid><b:Id>69</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:b98fd154-fd9a-4db6-b673-eddcd4007b14:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Persistent Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Authenticate user' could be a subject to a persistent cross-site scripting attack because it does not sanitize data store 'Keycloak database' inputs and output.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Stored values such as client names and user attributes are escaped on output. Login and broker pages are FreeMarker templates rendered with HTML auto-escaping (DefaultFreeMarkerProvider sets HTMLOutputFormat). Keycloak has shipped XSS fixes for these pages before, so stay on patched releases.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>User credentials and client registration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.169efece0-b5eb-43d2-9b89-de620ea514d9b98fd154-fd9a-4db6-b673-eddcd4007b14faad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b98fd154-fd9a-4db6-b673-eddcd4007b14</b:FlowGuid><b:Id>68</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:b98fd154-fd9a-4db6-b673-eddcd4007b14:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Authenticate user' could be a subject to a cross-site scripting attack because it does not sanitize untrusted input.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Client display names and user attributes from the database appear on login pages. Login and broker pages are FreeMarker templates rendered with HTML auto-escaping (DefaultFreeMarkerProvider sets HTMLOutputFormat). Keycloak has shipped XSS fixes for these pages before, so stay on patched releases.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>User credentials and client registration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S769efece0-b5eb-43d2-9b89-de620ea514d9b98fd154-fd9a-4db6-b673-eddcd4007b14faad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b98fd154-fd9a-4db6-b673-eddcd4007b14</b:FlowGuid><b:Id>67</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:b98fd154-fd9a-4db6-b673-eddcd4007b14:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store Keycloak database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Keycloak database may be spoofed by an attacker and this may lead to incorrect data delivered to Authenticate user. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak reaches its database over the configured JDBC connection with a dedicated database account. Restrict that account to the Keycloak schema, require TLS with certificate validation on the JDBC URL (Keycloak does not enforce it), and keep the database on a segment only Keycloak nodes can reach. Shared with Interaction 1.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>User credentials and client registration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2078cb915-58f8-45a4-81e1-ec4581c8944f4250e26d-d8bd-4adb-a934-39af5cb2720c69efece0-b5eb-43d2-9b89-de620ea514d9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4250e26d-d8bd-4adb-a934-39af5cb2720c</b:FlowGuid><b:Id>66</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:4250e26d-d8bd-4adb-a934-39af5cb2720c:69efece0-b5eb-43d2-9b89-de620ea514d9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for Broker external login or Keycloak database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Broker external login or Keycloak database take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Each brokered login creates at most one user and one identity link. Watch for unusual growth in users linked to the partner provider.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Brokered user, identity link, and mapped roles</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T7078cb915-58f8-45a4-81e1-ec4581c8944f4250e26d-d8bd-4adb-a934-39af5cb2720c69efece0-b5eb-43d2-9b89-de620ea514d9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4250e26d-d8bd-4adb-a934-39af5cb2720c</b:FlowGuid><b:Id>65</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:4250e26d-d8bd-4adb-a934-39af5cb2720c:69efece0-b5eb-43d2-9b89-de620ea514d9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for Keycloak database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Brokered users, links and role mappings are written through JPA/Hibernate with bound parameters, so assertion values are stored as data, not SQL.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Brokered user, identity link, and mapped roles</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S3c0f3289b-e983-4773-b26c-04d33fe11d58da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa</b:FlowGuid><b:Id>21</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the End user (browser) External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>End user (browser) may be spoofed by an attacker and this may lead to unauthorized access to Broker external login. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The broker login request only starts a redirect to the partner. It must carry the current authentication session reference (session_code, client_id, tab_id) and grants nothing by itself; the user's identity comes from the partner's signed assertion (SAML response).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.1c0f3289b-e983-4773-b26c-04d33fe11d58da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa</b:FlowGuid><b:Id>22</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Broker external login' could be a subject to a cross-site scripting attack because it does not sanitize untrusted input.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Login and broker pages are FreeMarker templates rendered with HTML auto-escaping (DefaultFreeMarkerProvider sets HTMLOutputFormat). Keycloak has shipped XSS fixes for these pages before, so stay on patched releases.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5c0f3289b-e983-4773-b26c-04d33fe11d58da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa</b:FlowGuid><b:Id>23</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Broker external login may be able to impersonate the context of End user (browser) in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Broker external login acts only within the browser's authentication session. Account Linking Only and disabled-client checks run on every brokered login (CVE-2026-16442 fix).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E3078cb915-58f8-45a4-81e1-ec4581c8944f6ca7b4b1-4a6e-496f-936e-ecc8429152a1cd1f84ce-7cd2-47a4-8a83-275f74dc9957</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>6ca7b4b1-4a6e-496f-936e-ecc8429152a1</b:FlowGuid><b:Id>24</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:6ca7b4b1-4a6e-496f-936e-ecc8429152a1:cd1f84ce-7cd2-47a4-8a83-275f74dc9957</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weakness in SSO Authorization</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Common SSO implementations such as OAUTH2 and OAUTH Wrap are vulnerable to MitM attacks.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>SAML messages pass through the browser over HTTPS. Want AuthnRequests Signed lets the partner verify Keycloak's request, and Validate Signature plus Identity Provider Entity ID make Keycloak verify the response. The request ID is stored in the authentication session and must come back as InResponseTo.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>SAML authentication request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>cd1f84ce-7cd2-47a4-8a83-275f74dc9957</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S3cd1f84ce-7cd2-47a4-8a83-275f74dc99579d5fead1-2e5e-4ff9-8bd7-3310b70d3f48078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>9d5fead1-2e5e-4ff9-8bd7-3310b70d3f48</b:FlowGuid><b:Id>25</b:Id><b:InteractionKey>cd1f84ce-7cd2-47a4-8a83-275f74dc9957:9d5fead1-2e5e-4ff9-8bd7-3310b70d3f48:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Partner identity provider External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Partner identity provider may be spoofed by an attacker and this may lead to unauthorized access to Broker external login. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Turn on Validate Signature with the partner's signing certificate pinned (or loaded from its metadata URL over TLS) and set Identity Provider Entity ID. Without them Keycloak accepts unsigned responses and skips the Issuer check, and Want Assertions Signed alone only checks that a signature is present. SP-initiated responses are bound to the request ID; leave the IDP-Initiated SSO URL name unset on partner-facing clients so unsolicited responses are refused.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>SAML response</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cd1f84ce-7cd2-47a4-8a83-275f74dc9957</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.1cd1f84ce-7cd2-47a4-8a83-275f74dc99579d5fead1-2e5e-4ff9-8bd7-3310b70d3f48078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>9d5fead1-2e5e-4ff9-8bd7-3310b70d3f48</b:FlowGuid><b:Id>26</b:Id><b:InteractionKey>cd1f84ce-7cd2-47a4-8a83-275f74dc9957:9d5fead1-2e5e-4ff9-8bd7-3310b70d3f48:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Broker external login' could be a subject to a cross-site scripting attack because it does not sanitize untrusted input.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Assertion attribute values shown on the first broker login review-profile page are escaped. Login and broker pages are FreeMarker templates rendered with HTML auto-escaping (DefaultFreeMarkerProvider sets HTMLOutputFormat). Keycloak has shipped XSS fixes for these pages before, so stay on patched releases.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>SAML response</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cd1f84ce-7cd2-47a4-8a83-275f74dc9957</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5cd1f84ce-7cd2-47a4-8a83-275f74dc99579d5fead1-2e5e-4ff9-8bd7-3310b70d3f48078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>9d5fead1-2e5e-4ff9-8bd7-3310b70d3f48</b:FlowGuid><b:Id>27</b:Id><b:InteractionKey>cd1f84ce-7cd2-47a4-8a83-275f74dc9957:9d5fead1-2e5e-4ff9-8bd7-3310b70d3f48:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Broker external login may be able to impersonate the context of Partner identity provider in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The partner can assert group values that mappers turn into roles. Our design maps the partner only to a contractor role and uses Force sync mode so roles are re-checked each login, and 26.8.0 (CVE-2026-12388) blocks admin roles through mappers by default. Gap: anyone with manage-identity-providers can still create a mapper that grants non-admin business roles such as finance or payroll.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>SAML response</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cd1f84ce-7cd2-47a4-8a83-275f74dc9957</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2faad0146-5dfe-449f-a49e-d4aa6a26779b22dae46d-d52a-4f99-8b90-b5b44d2b4c73845efa87-110e-4ad5-a2ea-a0a90d024814</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>22dae46d-d52a-4f99-8b90-b5b44d2b4c73</b:FlowGuid><b:Id>48</b:Id><b:InteractionKey>faad0146-5dfe-449f-a49e-d4aa6a26779b:22dae46d-d52a-4f99-8b90-b5b44d2b4c73:845efa87-110e-4ad5-a2ea-a0a90d024814</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for Authenticate user or Session store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Authenticate user or Session store take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Codes are single-use and expire with the client login timeout, and the number of authentication sessions per browser session is capped. Cache sizing is a deployment setting.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization code record</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1faad0146-5dfe-449f-a49e-d4aa6a26779b22dae46d-d52a-4f99-8b90-b5b44d2b4c73845efa87-110e-4ad5-a2ea-a0a90d024814</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>22dae46d-d52a-4f99-8b90-b5b44d2b4c73</b:FlowGuid><b:Id>47</b:Id><b:InteractionKey>faad0146-5dfe-449f-a49e-d4aa6a26779b:22dae46d-d52a-4f99-8b90-b5b44d2b4c73:845efa87-110e-4ad5-a2ea-a0a90d024814</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store Session store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Session store may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of Session store. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The session store is Keycloak's embedded Infinispan cache, persisted to the Keycloak database. Cluster traffic between nodes is TLS-encrypted by default, and nodes need the cluster certificate stored in the database to join.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization code record</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2abb28a11-f9b6-4a30-af74-73ce025f96ebebb2d164-0220-47aa-9f4c-8b57afb48a72845efa87-110e-4ad5-a2ea-a0a90d024814</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>ebb2d164-0220-47aa-9f4c-8b57afb48a72</b:FlowGuid><b:Id>46</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:ebb2d164-0220-47aa-9f4c-8b57afb48a72:845efa87-110e-4ad5-a2ea-a0a90d024814</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for Issue tokens or Session store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Issue tokens or Session store take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Client sessions are bounded by the realm's SSO Session Max and client session timeouts.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client session update</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1abb28a11-f9b6-4a30-af74-73ce025f96ebebb2d164-0220-47aa-9f4c-8b57afb48a72845efa87-110e-4ad5-a2ea-a0a90d024814</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>ebb2d164-0220-47aa-9f4c-8b57afb48a72</b:FlowGuid><b:Id>45</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:ebb2d164-0220-47aa-9f4c-8b57afb48a72:845efa87-110e-4ad5-a2ea-a0a90d024814</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store Session store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Session store may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of Session store. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The session store is Keycloak's embedded Infinispan cache, persisted to the Keycloak database. Cluster traffic between nodes is TLS-encrypted by default, and nodes need the cluster certificate stored in the database to join.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client session update</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.2845efa87-110e-4ad5-a2ea-a0a90d024814b36ca88a-a70d-4491-9da2-1982de6cb55eabb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b36ca88a-a70d-4491-9da2-1982de6cb55e</b:FlowGuid><b:Id>51</b:Id><b:InteractionKey>845efa87-110e-4ad5-a2ea-a0a90d024814:b36ca88a-a70d-4491-9da2-1982de6cb55e:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Persistent Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Issue tokens' could be a subject to a persistent cross-site scripting attack because it does not sanitize data store 'Session store' inputs and output.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Issue tokens is a back-channel JSON endpoint and renders no HTML, so cross-site scripting does not apply to this flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Code record and client session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.1845efa87-110e-4ad5-a2ea-a0a90d024814b36ca88a-a70d-4491-9da2-1982de6cb55eabb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b36ca88a-a70d-4491-9da2-1982de6cb55e</b:FlowGuid><b:Id>50</b:Id><b:InteractionKey>845efa87-110e-4ad5-a2ea-a0a90d024814:b36ca88a-a70d-4491-9da2-1982de6cb55e:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Issue tokens' could be a subject to a cross-site scripting attack because it does not sanitize untrusted input.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Issue tokens is a back-channel JSON endpoint and renders no HTML, so cross-site scripting does not apply to this flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Code record and client session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7845efa87-110e-4ad5-a2ea-a0a90d024814b36ca88a-a70d-4491-9da2-1982de6cb55eabb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b36ca88a-a70d-4491-9da2-1982de6cb55e</b:FlowGuid><b:Id>49</b:Id><b:InteractionKey>845efa87-110e-4ad5-a2ea-a0a90d024814:b36ca88a-a70d-4491-9da2-1982de6cb55e:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store Session store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Session store may be spoofed by an attacker and this may lead to incorrect data delivered to Issue tokens. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Issue tokens reads from Keycloak's own session store. The session store is Keycloak's embedded Infinispan cache, persisted to the Keycloak database. Cluster traffic between nodes is TLS-encrypted by default, and nodes need the cluster certificate stored in the database to join.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Code record and client session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T2078cb915-58f8-45a4-81e1-ec4581c8944f1b50419a-ecff-4dc0-bfd0-3fd444de0c07faad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>1b50419a-ecff-4dc0-bfd0-3fd444de0c07</b:FlowGuid><b:Id>35</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:1b50419a-ecff-4dc0-bfd0-3fd444de0c07:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Broker external login Process Memory Tampered</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If Broker external login is given access to memory, such as shared memory or pointers, or is given the ability to control what Authenticate user executes (for example, passing back a function pointer.), then Broker external login can tamper with Authenticate user. Consider if the function could work with less access to memory, such as passing data rather than pointers. Copy in data provided, and then validate it.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Broker external login and Authenticate user are parts of the same Keycloak server process; the brokered identity is passed as an in-memory object, not across a trust boundary or shared memory.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Brokered identity context</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.1078cb915-58f8-45a4-81e1-ec4581c8944f1b50419a-ecff-4dc0-bfd0-3fd444de0c07faad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>1b50419a-ecff-4dc0-bfd0-3fd444de0c07</b:FlowGuid><b:Id>36</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:1b50419a-ecff-4dc0-bfd0-3fd444de0c07:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Authenticate user' could be a subject to a cross-site scripting attack because it does not sanitize untrusted input.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Brokered attributes shown on the review-profile page are escaped. Login and broker pages are FreeMarker templates rendered with HTML auto-escaping (DefaultFreeMarkerProvider sets HTMLOutputFormat). Keycloak has shipped XSS fixes for these pages before, so stay on patched releases.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Brokered identity context</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5078cb915-58f8-45a4-81e1-ec4581c8944f1b50419a-ecff-4dc0-bfd0-3fd444de0c07faad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>1b50419a-ecff-4dc0-bfd0-3fd444de0c07</b:FlowGuid><b:Id>37</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:1b50419a-ecff-4dc0-bfd0-3fd444de0c07:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Authenticate user may be able to impersonate the context of Broker external login in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authenticate user runs the first broker login flow before linking or creating an account. The default flow requires email verification or re-authentication before linking (SR-4.2); an auto-link flow must not be used for the partner.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Brokered identity context</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1078cb915-58f8-45a4-81e1-ec4581c8944f4250e26d-d8bd-4adb-a934-39af5cb2720c69efece0-b5eb-43d2-9b89-de620ea514d9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4250e26d-d8bd-4adb-a934-39af5cb2720c</b:FlowGuid><b:Id>64</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:4250e26d-d8bd-4adb-a934-39af5cb2720c:69efece0-b5eb-43d2-9b89-de620ea514d9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store Keycloak database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Keycloak database may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of Keycloak database. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak reaches its database over the configured JDBC connection with a dedicated database account. Restrict that account to the Keycloak schema, require TLS with certificate validation on the JDBC URL (Keycloak does not enforce it), and keep the database on a segment only Keycloak nodes can reach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Brokered user, identity link, and mapped roles</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2abb28a11-f9b6-4a30-af74-73ce025f96eb6ebc3649-214e-475d-9ce7-1f801c80aa6b72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>6ebc3649-214e-475d-9ce7-1f801c80aa6b</b:FlowGuid><b:Id>63</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:6ebc3649-214e-475d-9ce7-1f801c80aa6b:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for Issue tokens or Event store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Issue tokens or Event store take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Saved events have a configurable expiration, which bounds table growth; the SIEM keeps the long-term copy.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T7abb28a11-f9b6-4a30-af74-73ce025f96eb6ebc3649-214e-475d-9ce7-1f801c80aa6b72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>6ebc3649-214e-475d-9ce7-1f801c80aa6b</b:FlowGuid><b:Id>62</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:6ebc3649-214e-475d-9ce7-1f801c80aa6b:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for Event store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak writes events through JPA/Hibernate with bound parameters, so request details are stored as values, not SQL.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1abb28a11-f9b6-4a30-af74-73ce025f96eb6ebc3649-214e-475d-9ce7-1f801c80aa6b72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>6ebc3649-214e-475d-9ce7-1f801c80aa6b</b:FlowGuid><b:Id>61</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:6ebc3649-214e-475d-9ce7-1f801c80aa6b:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store Event store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Event store may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of Event store. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The event store is the event table in the Keycloak database, written only when Save events is on. Keycloak reaches its database over the configured JDBC connection with a dedicated database account. Restrict that account to the Keycloak schema, require TLS with certificate validation on the JDBC URL (Keycloak does not enforce it), and keep the database on a segment only Keycloak nodes can reach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I2369efece0-b5eb-43d2-9b89-de620ea514d968315d65-888b-4581-8cae-ef6f646fc622078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>68315d65-888b-4581-8cae-ef6f646fc622</b:FlowGuid><b:Id>60</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:68315d65-888b-4581-8cae-ef6f646fc622:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of Keycloak database can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>This flow carries the partner's public signing certificate and mapper definitions, nothing secret. Changing them requires manage-identity-providers (Interaction 2), and admin events record the change when enabled.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Identity provider configuration and mappers</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.269efece0-b5eb-43d2-9b89-de620ea514d968315d65-888b-4581-8cae-ef6f646fc622078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>68315d65-888b-4581-8cae-ef6f646fc622</b:FlowGuid><b:Id>59</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:68315d65-888b-4581-8cae-ef6f646fc622:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Persistent Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Broker external login' could be a subject to a persistent cross-site scripting attack because it does not sanitize data store 'Keycloak database' inputs and output.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Stored provider settings shown on pages are escaped. Login and broker pages are FreeMarker templates rendered with HTML auto-escaping (DefaultFreeMarkerProvider sets HTMLOutputFormat). Keycloak has shipped XSS fixes for these pages before, so stay on patched releases.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Identity provider configuration and mappers</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.169efece0-b5eb-43d2-9b89-de620ea514d968315d65-888b-4581-8cae-ef6f646fc622078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>68315d65-888b-4581-8cae-ef6f646fc622</b:FlowGuid><b:Id>58</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:68315d65-888b-4581-8cae-ef6f646fc622:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Broker external login' could be a subject to a cross-site scripting attack because it does not sanitize untrusted input.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Provider display names shown on the login page are escaped. Login and broker pages are FreeMarker templates rendered with HTML auto-escaping (DefaultFreeMarkerProvider sets HTMLOutputFormat). Keycloak has shipped XSS fixes for these pages before, so stay on patched releases.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Identity provider configuration and mappers</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4faad0146-5dfe-449f-a49e-d4aa6a26779b464ef0f8-9060-406f-b37e-56002bfe3099c0f3289b-e983-4773-b26c-04d33fe11d58</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>464ef0f8-9060-406f-b37e-56002bfe3099</b:FlowGuid><b:Id>91</b:Id><b:InteractionKey>faad0146-5dfe-449f-a49e-d4aa6a26779b:464ef0f8-9060-406f-b37e-56002bfe3099:c0f3289b-e983-4773-b26c-04d33fe11d58</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Authorization response Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>An undelivered code is never redeemed and expires with the client login timeout, 60 seconds by default; we set it under 10 seconds as Keycloak's threat docs advise. The user restarts login.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization response</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R7faad0146-5dfe-449f-a49e-d4aa6a26779b464ef0f8-9060-406f-b37e-56002bfe3099c0f3289b-e983-4773-b26c-04d33fe11d58</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>464ef0f8-9060-406f-b37e-56002bfe3099</b:FlowGuid><b:Id>90</b:Id><b:InteractionKey>faad0146-5dfe-449f-a49e-d4aa6a26779b:464ef0f8-9060-406f-b37e-56002bfe3099:c0f3289b-e983-4773-b26c-04d33fe11d58</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity End user (browser) Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>End user (browser) claims that it did not receive data from a process on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The LOGIN event records the code being issued, and a matching CODE_TO_TOKEN event (or its absence) shows whether the client redeemed it. Save events is off by default and only error events reach the server log, so our configuration turns it on and forwards events to the SIEM.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization response</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S8faad0146-5dfe-449f-a49e-d4aa6a26779b464ef0f8-9060-406f-b37e-56002bfe3099c0f3289b-e983-4773-b26c-04d33fe11d58</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>464ef0f8-9060-406f-b37e-56002bfe3099</b:FlowGuid><b:Id>89</b:Id><b:InteractionKey>faad0146-5dfe-449f-a49e-d4aa6a26779b:464ef0f8-9060-406f-b37e-56002bfe3099:c0f3289b-e983-4773-b26c-04d33fe11d58</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the End user (browser) External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>End user (browser) may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of End user (browser). Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>This is the redirect URI manipulation threat. Register exact redirect URIs and enable the secure-redirect-uris-enforcer client policy (off by default) so wildcard and loopback registrations are rejected; a trailing * is otherwise honored as a prefix match. For confidential clients, the client secret stops an attacker from redeeming a misdelivered code.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization response</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b0261c0f3289b-e983-4773-b26c-04d33fe11d584a372f5c-247e-4418-8453-0d4461508c4cfaad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4a372f5c-247e-4418-8453-0d4461508c4c</b:FlowGuid><b:Id>88</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:4a372f5c-247e-4418-8453-0d4461508c4c:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting. The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Login form posts must carry the authentication session's session_code and tab_id along with the session cookie, so a forged cross-site post does not match. The OIDC state parameter protects the client side and must be checked by the client.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7c0f3289b-e983-4773-b26c-04d33fe11d584a372f5c-247e-4418-8453-0d4461508c4cfaad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4a372f5c-247e-4418-8453-0d4461508c4c</b:FlowGuid><b:Id>87</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:4a372f5c-247e-4418-8453-0d4461508c4c:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Authenticate user</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Authenticate user in order to change the flow of program execution within Authenticate user to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authentication flows are server-side and bound to the authentication session (session_code, execution, tab_id). A request that skips or replays a step is rejected and the flow restarts.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6c0f3289b-e983-4773-b26c-04d33fe11d584a372f5c-247e-4418-8453-0d4461508c4cfaad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4a372f5c-247e-4418-8453-0d4461508c4c</b:FlowGuid><b:Id>86</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:4a372f5c-247e-4418-8453-0d4461508c4c:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Authenticate user May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>End user (browser) may be able to remotely execute code for Authenticate user.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The process parses parameters and tokens with standard libraries and never evaluates input as code. Keep Keycloak and its Java runtime patched and run it as an unprivileged user.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4c0f3289b-e983-4773-b26c-04d33fe11d584a372f5c-247e-4418-8453-0d4461508c4cfaad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4a372f5c-247e-4418-8453-0d4461508c4c</b:FlowGuid><b:Id>85</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:4a372f5c-247e-4418-8453-0d4461508c4c:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Authorization request Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Production mode refuses to start without HTTPS, which protects integrity. If this flow is interrupted, no code, token, or session is issued, so the login fails closed and the user starts over.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3c0f3289b-e983-4773-b26c-04d33fe11d584a372f5c-247e-4418-8453-0d4461508c4cfaad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4a372f5c-247e-4418-8453-0d4461508c4c</b:FlowGuid><b:Id>84</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:4a372f5c-247e-4418-8453-0d4461508c4c:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Authenticate user</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Authenticate user crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Brute-force detection limits repeated login failures (Interaction 1). Keycloak has no per-client or per-IP rate limiting. Set http-max-queued-requests (no limit by default) so the server sheds load, and rate-limit by client and source IP at the reverse proxy. Run at least two nodes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6c0f3289b-e983-4773-b26c-04d33fe11d584a372f5c-247e-4418-8453-0d4461508c4cfaad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4a372f5c-247e-4418-8453-0d4461508c4c</b:FlowGuid><b:Id>83</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:4a372f5c-247e-4418-8453-0d4461508c4c:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Authenticate user</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Authenticate user claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak records LOGIN, LOGIN_ERROR and CODE_TO_TOKEN events with client_id, IP and session. Save events is off by default and only error events reach the server log, so our configuration turns it on and forwards events to the SIEM.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R63bba3f71-e38e-4f23-9dc9-978f379ee727c308f42b-1abc-4b15-9b02-63e25c3fb378abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>c308f42b-1abc-4b15-9b02-63e25c3fb378</b:FlowGuid><b:Id>92</b:Id><b:InteractionKey>3bba3f71-e38e-4f23-9dc9-978f379ee727:c308f42b-1abc-4b15-9b02-63e25c3fb378:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Issue tokens</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issue tokens claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak records CODE_TO_TOKEN, REFRESH_TOKEN and their error events with client_id and IP. Save events is off by default and only error events reach the server log, so our configuration turns it on and forwards events to the SIEM.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3bba3f71-e38e-4f23-9dc9-978f379ee727</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D33bba3f71-e38e-4f23-9dc9-978f379ee727c308f42b-1abc-4b15-9b02-63e25c3fb378abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>c308f42b-1abc-4b15-9b02-63e25c3fb378</b:FlowGuid><b:Id>93</b:Id><b:InteractionKey>3bba3f71-e38e-4f23-9dc9-978f379ee727:c308f42b-1abc-4b15-9b02-63e25c3fb378:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Issue tokens</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issue tokens crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak has no per-client or per-IP rate limiting. Set http-max-queued-requests (no limit by default) so the server sheds load, and rate-limit by client and source IP at the reverse proxy. Run at least two nodes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3bba3f71-e38e-4f23-9dc9-978f379ee727</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D43bba3f71-e38e-4f23-9dc9-978f379ee727c308f42b-1abc-4b15-9b02-63e25c3fb378abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>c308f42b-1abc-4b15-9b02-63e25c3fb378</b:FlowGuid><b:Id>94</b:Id><b:InteractionKey>3bba3f71-e38e-4f23-9dc9-978f379ee727:c308f42b-1abc-4b15-9b02-63e25c3fb378:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Token request Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>TLS protects integrity. A code is removed from the store when it is redeemed, so an interrupted redemption means the user logs in again; refresh requests can simply be retried.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3bba3f71-e38e-4f23-9dc9-978f379ee727</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E63bba3f71-e38e-4f23-9dc9-978f379ee727c308f42b-1abc-4b15-9b02-63e25c3fb378abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>c308f42b-1abc-4b15-9b02-63e25c3fb378</b:FlowGuid><b:Id>95</b:Id><b:InteractionKey>3bba3f71-e38e-4f23-9dc9-978f379ee727:c308f42b-1abc-4b15-9b02-63e25c3fb378:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Issue tokens May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Client application may be able to remotely execute code for Issue tokens.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The process parses parameters and tokens with standard libraries and never evaluates input as code. Keep Keycloak and its Java runtime patched and run it as an unprivileged user.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3bba3f71-e38e-4f23-9dc9-978f379ee727</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E73bba3f71-e38e-4f23-9dc9-978f379ee727c308f42b-1abc-4b15-9b02-63e25c3fb378abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>c308f42b-1abc-4b15-9b02-63e25c3fb378</b:FlowGuid><b:Id>96</b:Id><b:InteractionKey>3bba3f71-e38e-4f23-9dc9-978f379ee727:c308f42b-1abc-4b15-9b02-63e25c3fb378:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Issue tokens</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Issue tokens in order to change the flow of program execution within Issue tokens to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Each grant type has its own handler. The authorization code grant checks that the code is valid and unused, belongs to the calling client, matches redirect_uri, and passes PKCE before issuing tokens (AuthorizationCodeGrantType).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3bba3f71-e38e-4f23-9dc9-978f379ee727</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S8abb28a11-f9b6-4a30-af74-73ce025f96eba4634a0a-55b1-45dd-a8f0-0a1d7c2eac993bba3f71-e38e-4f23-9dc9-978f379ee727</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>a4634a0a-55b1-45dd-a8f0-0a1d7c2eac99</b:FlowGuid><b:Id>97</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:a4634a0a-55b1-45dd-a8f0-0a1d7c2eac99:3bba3f71-e38e-4f23-9dc9-978f379ee727</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the Client application External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Client application may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of Client application. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Tokens go back on the TLS connection the client opened, so only the party that authenticated or presented the PKCE verifier receives them. Turning off Full Scope Allowed and setting audiences limits what a misdirected token can do.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token response</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3bba3f71-e38e-4f23-9dc9-978f379ee727</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R7abb28a11-f9b6-4a30-af74-73ce025f96eba4634a0a-55b1-45dd-a8f0-0a1d7c2eac993bba3f71-e38e-4f23-9dc9-978f379ee727</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>a4634a0a-55b1-45dd-a8f0-0a1d7c2eac99</b:FlowGuid><b:Id>98</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:a4634a0a-55b1-45dd-a8f0-0a1d7c2eac99:3bba3f71-e38e-4f23-9dc9-978f379ee727</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity Client application Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Client application claims that it did not receive data from a process on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>CODE_TO_TOKEN and REFRESH_TOKEN events record issuance to the client. Save events is off by default and only error events reach the server log, so our configuration turns it on and forwards events to the SIEM.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token response</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3bba3f71-e38e-4f23-9dc9-978f379ee727</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4abb28a11-f9b6-4a30-af74-73ce025f96eba4634a0a-55b1-45dd-a8f0-0a1d7c2eac993bba3f71-e38e-4f23-9dc9-978f379ee727</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>a4634a0a-55b1-45dd-a8f0-0a1d7c2eac99</b:FlowGuid><b:Id>99</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:a4634a0a-55b1-45dd-a8f0-0a1d7c2eac99:3bba3f71-e38e-4f23-9dc9-978f379ee727</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Token response Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The client retries with a refresh token or restarts login; the consumed code cannot be reused.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token response</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3bba3f71-e38e-4f23-9dc9-978f379ee727</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6c0f3289b-e983-4773-b26c-04d33fe11d58da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa</b:FlowGuid><b:Id>100</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Broker external login</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Broker external login claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>IDENTITY_PROVIDER_LOGIN and its error events record brokered logins. Save events is off by default and only error events reach the server log, so our configuration turns it on and forwards events to the SIEM.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3c0f3289b-e983-4773-b26c-04d33fe11d58da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa</b:FlowGuid><b:Id>101</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Broker external login</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Broker external login crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak has no per-client or per-IP rate limiting. Set http-max-queued-requests (no limit by default) so the server sheds load, and rate-limit by client and source IP at the reverse proxy. Run at least two nodes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4c0f3289b-e983-4773-b26c-04d33fe11d58da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa</b:FlowGuid><b:Id>102</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Broker login request Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If this flow is interrupted, no code, token, or session is issued, so the login fails closed and the user starts over.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6c0f3289b-e983-4773-b26c-04d33fe11d58da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa</b:FlowGuid><b:Id>103</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Broker external login May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>End user (browser) may be able to remotely execute code for Broker external login.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The process parses parameters and tokens with standard libraries and never evaluates input as code. Keep Keycloak and its Java runtime patched and run it as an unprivileged user.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7c0f3289b-e983-4773-b26c-04d33fe11d58da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa</b:FlowGuid><b:Id>104</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Broker external login</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Broker external login in order to change the flow of program execution within Broker external login to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The broker endpoint validates the authentication session and the provider alias, and rejects disabled providers and link-only providers for login.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b0261c0f3289b-e983-4773-b26c-04d33fe11d58da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa</b:FlowGuid><b:Id>105</b:Id><b:InteractionKey>c0f3289b-e983-4773-b26c-04d33fe11d58:da5fa2c2-e14d-4de7-8c1a-d7b7f5454afa:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting. The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The request must carry the current authentication session's session_code and tab_id with the session cookie, so a forged cross-site request is rejected.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c0f3289b-e983-4773-b26c-04d33fe11d58</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S8078cb915-58f8-45a4-81e1-ec4581c8944f6ca7b4b1-4a6e-496f-936e-ecc8429152a1cd1f84ce-7cd2-47a4-8a83-275f74dc9957</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>6ca7b4b1-4a6e-496f-936e-ecc8429152a1</b:FlowGuid><b:Id>106</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:6ca7b4b1-4a6e-496f-936e-ecc8429152a1:cd1f84ce-7cd2-47a4-8a83-275f74dc9957</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the Partner identity provider External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Partner identity provider may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of Partner identity provider. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The partner's single sign-on URL is fixed in the provider configuration (or imported from partner metadata over TLS), so the browser is only sent there.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>SAML authentication request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>cd1f84ce-7cd2-47a4-8a83-275f74dc9957</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R7078cb915-58f8-45a4-81e1-ec4581c8944f6ca7b4b1-4a6e-496f-936e-ecc8429152a1cd1f84ce-7cd2-47a4-8a83-275f74dc9957</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>6ca7b4b1-4a6e-496f-936e-ecc8429152a1</b:FlowGuid><b:Id>107</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:6ca7b4b1-4a6e-496f-936e-ecc8429152a1:cd1f84ce-7cd2-47a4-8a83-275f74dc9957</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity Partner identity provider Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Partner identity provider claims that it did not receive data from a process on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak keeps the outgoing request ID in the authentication session, and the partner's response must reference it. The partner's own logs cover its side.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>SAML authentication request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>cd1f84ce-7cd2-47a4-8a83-275f74dc9957</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4078cb915-58f8-45a4-81e1-ec4581c8944f6ca7b4b1-4a6e-496f-936e-ecc8429152a1cd1f84ce-7cd2-47a4-8a83-275f74dc9957</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>6ca7b4b1-4a6e-496f-936e-ecc8429152a1</b:FlowGuid><b:Id>108</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:6ca7b4b1-4a6e-496f-936e-ecc8429152a1:cd1f84ce-7cd2-47a4-8a83-275f74dc9957</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow SAML authentication request Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If the partner is unreachable, brokered login fails and no session is created; employees still log in directly (Interaction 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>SAML authentication request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>cd1f84ce-7cd2-47a4-8a83-275f74dc9957</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6cd1f84ce-7cd2-47a4-8a83-275f74dc99579d5fead1-2e5e-4ff9-8bd7-3310b70d3f48078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>9d5fead1-2e5e-4ff9-8bd7-3310b70d3f48</b:FlowGuid><b:Id>109</b:Id><b:InteractionKey>cd1f84ce-7cd2-47a4-8a83-275f74dc9957:9d5fead1-2e5e-4ff9-8bd7-3310b70d3f48:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Broker external login</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Broker external login claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>With Save events on, IDENTITY_PROVIDER_LOGIN, IDENTITY_PROVIDER_FIRST_LOGIN and FEDERATED_IDENTITY_LINK record brokered logins, and Store Tokens keeps the latest assertion. Gap: both are off by default, and role grants made by mappers emit no event, so a grant cannot be traced back to the assertion that caused it.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>SAML response</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cd1f84ce-7cd2-47a4-8a83-275f74dc9957</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3cd1f84ce-7cd2-47a4-8a83-275f74dc99579d5fead1-2e5e-4ff9-8bd7-3310b70d3f48078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>9d5fead1-2e5e-4ff9-8bd7-3310b70d3f48</b:FlowGuid><b:Id>110</b:Id><b:InteractionKey>cd1f84ce-7cd2-47a4-8a83-275f74dc9957:9d5fead1-2e5e-4ff9-8bd7-3310b70d3f48:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Broker external login</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Broker external login crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The SAML parser rejects DOCTYPE declarations and external entities (DocumentUtil, StaxParserUtil), which blocks entity-expansion attacks. Cap request size and rate at the reverse proxy and set http-max-queued-requests.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>SAML response</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cd1f84ce-7cd2-47a4-8a83-275f74dc9957</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4cd1f84ce-7cd2-47a4-8a83-275f74dc99579d5fead1-2e5e-4ff9-8bd7-3310b70d3f48078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>9d5fead1-2e5e-4ff9-8bd7-3310b70d3f48</b:FlowGuid><b:Id>111</b:Id><b:InteractionKey>cd1f84ce-7cd2-47a4-8a83-275f74dc9957:9d5fead1-2e5e-4ff9-8bd7-3310b70d3f48:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow SAML response Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If the response never arrives, the authentication session expires and the user restarts login; nothing is created.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>SAML response</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cd1f84ce-7cd2-47a4-8a83-275f74dc9957</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6cd1f84ce-7cd2-47a4-8a83-275f74dc99579d5fead1-2e5e-4ff9-8bd7-3310b70d3f48078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>9d5fead1-2e5e-4ff9-8bd7-3310b70d3f48</b:FlowGuid><b:Id>112</b:Id><b:InteractionKey>cd1f84ce-7cd2-47a4-8a83-275f74dc9957:9d5fead1-2e5e-4ff9-8bd7-3310b70d3f48:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Broker external login May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Partner identity provider may be able to remotely execute code for Broker external login.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>XML parsing is hardened as above, and signatures are verified on the element Keycloak actually reads. The process parses parameters and tokens with standard libraries and never evaluates input as code. Keep Keycloak and its Java runtime patched and run it as an unprivileged user.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>SAML response</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cd1f84ce-7cd2-47a4-8a83-275f74dc9957</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7cd1f84ce-7cd2-47a4-8a83-275f74dc99579d5fead1-2e5e-4ff9-8bd7-3310b70d3f48078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>9d5fead1-2e5e-4ff9-8bd7-3310b70d3f48</b:FlowGuid><b:Id>113</b:Id><b:InteractionKey>cd1f84ce-7cd2-47a4-8a83-275f74dc9957:9d5fead1-2e5e-4ff9-8bd7-3310b70d3f48:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Broker external login</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Broker external login in order to change the flow of program execution within Broker external login to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>IdP-initiated logins only work for clients with an IDP-Initiated SSO URL name, and Account Linking Only and disabled-client checks run on every entry point (CVE-2026-16442 fix). The default first broker login flow requires email verification or re-authentication before linking an existing account; Trust Email stays off for the partner.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>SAML response</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cd1f84ce-7cd2-47a4-8a83-275f74dc9957</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S1faad0146-5dfe-449f-a49e-d4aa6a26779b22dae46d-d52a-4f99-8b90-b5b44d2b4c73845efa87-110e-4ad5-a2ea-a0a90d024814</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>22dae46d-d52a-4f99-8b90-b5b44d2b4c73</b:FlowGuid><b:Id>114</b:Id><b:InteractionKey>faad0146-5dfe-449f-a49e-d4aa6a26779b:22dae46d-d52a-4f99-8b90-b5b44d2b4c73:845efa87-110e-4ad5-a2ea-a0a90d024814</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Authenticate user Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Authenticate user may be spoofed by an attacker and this may lead to unauthorized access to Session store. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Only Keycloak nodes write to the session store. The session store is Keycloak's embedded Infinispan cache, persisted to the Keycloak database. Cluster traffic between nodes is TLS-encrypted by default, and nodes need the cluster certificate stored in the database to join.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization code record</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T18faad0146-5dfe-449f-a49e-d4aa6a26779b22dae46d-d52a-4f99-8b90-b5b44d2b4c73845efa87-110e-4ad5-a2ea-a0a90d024814</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>22dae46d-d52a-4f99-8b90-b5b44d2b4c73</b:FlowGuid><b:Id>115</b:Id><b:InteractionKey>faad0146-5dfe-449f-a49e-d4aa6a26779b:22dae46d-d52a-4f99-8b90-b5b44d2b4c73:845efa87-110e-4ad5-a2ea-a0a90d024814</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>The Session store Data Store Could Be Corrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Authorization code record may be tampered with by an attacker. This may lead to corruption of Session store. Ensure the integrity of the data flow to the data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The code record (PKCE challenge, redirect URI, user session) stays server-side and never passes through the browser. Changing it requires access to the cache or database, which only Keycloak nodes have. The session store is Keycloak's embedded Infinispan cache, persisted to the Keycloak database. Cluster traffic between nodes is TLS-encrypted by default, and nodes need the cluster certificate stored in the database to join.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization code record</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R8faad0146-5dfe-449f-a49e-d4aa6a26779b22dae46d-d52a-4f99-8b90-b5b44d2b4c73845efa87-110e-4ad5-a2ea-a0a90d024814</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>22dae46d-d52a-4f99-8b90-b5b44d2b4c73</b:FlowGuid><b:Id>116</b:Id><b:InteractionKey>faad0146-5dfe-449f-a49e-d4aa6a26779b:22dae46d-d52a-4f99-8b90-b5b44d2b4c73:845efa87-110e-4ad5-a2ea-a0a90d024814</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Denies Session store Potentially Writing Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Session store claims that it did not write data received from an entity on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Writes happen inside Keycloak as part of the request. Failures surface as server errors and error events. The LOGIN event records the code being issued.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization code record</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6faad0146-5dfe-449f-a49e-d4aa6a26779b22dae46d-d52a-4f99-8b90-b5b44d2b4c73845efa87-110e-4ad5-a2ea-a0a90d024814</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>22dae46d-d52a-4f99-8b90-b5b44d2b4c73</b:FlowGuid><b:Id>117</b:Id><b:InteractionKey>faad0146-5dfe-449f-a49e-d4aa6a26779b:22dae46d-d52a-4f99-8b90-b5b44d2b4c73:845efa87-110e-4ad5-a2ea-a0a90d024814</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Authorization code record may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Cache replication between nodes is TLS-encrypted by default. Persisted sessions travel over the JDBC connection, which needs TLS that Keycloak does not enforce; our deployment requires it.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization code record</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4faad0146-5dfe-449f-a49e-d4aa6a26779b22dae46d-d52a-4f99-8b90-b5b44d2b4c73845efa87-110e-4ad5-a2ea-a0a90d024814</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>22dae46d-d52a-4f99-8b90-b5b44d2b4c73</b:FlowGuid><b:Id>118</b:Id><b:InteractionKey>faad0146-5dfe-449f-a49e-d4aa6a26779b:22dae46d-d52a-4f99-8b90-b5b44d2b4c73:845efa87-110e-4ad5-a2ea-a0a90d024814</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Authorization code record Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If this flow is interrupted, no code, token, or session is issued, so the login fails closed and the user starts over.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization code record</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5faad0146-5dfe-449f-a49e-d4aa6a26779b22dae46d-d52a-4f99-8b90-b5b44d2b4c73845efa87-110e-4ad5-a2ea-a0a90d024814</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>22dae46d-d52a-4f99-8b90-b5b44d2b4c73</b:FlowGuid><b:Id>119</b:Id><b:InteractionKey>faad0146-5dfe-449f-a49e-d4aa6a26779b:22dae46d-d52a-4f99-8b90-b5b44d2b4c73:845efa87-110e-4ad5-a2ea-a0a90d024814</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If the store is unavailable, logins and token requests fail closed. Availability comes from database replication and a clustered cache.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authorization code record</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S269efece0-b5eb-43d2-9b89-de620ea514d9b98fd154-fd9a-4db6-b673-eddcd4007b14faad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b98fd154-fd9a-4db6-b673-eddcd4007b14</b:FlowGuid><b:Id>120</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:b98fd154-fd9a-4db6-b673-eddcd4007b14:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Authenticate user Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Authenticate user may be spoofed by an attacker and this may lead to information disclosure by Keycloak database. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak reaches its database over the configured JDBC connection with a dedicated database account. Restrict that account to the Keycloak schema, require TLS with certificate validation on the JDBC URL (Keycloak does not enforce it), and keep the database on a segment only Keycloak nodes can reach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>User credentials and client registration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R669efece0-b5eb-43d2-9b89-de620ea514d9b98fd154-fd9a-4db6-b673-eddcd4007b14faad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b98fd154-fd9a-4db6-b673-eddcd4007b14</b:FlowGuid><b:Id>121</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:b98fd154-fd9a-4db6-b673-eddcd4007b14:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Authenticate user</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Authenticate user claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Admin events record client and user changes made through the admin API when enabled; database audit logging covers direct changes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>User credentials and client registration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D369efece0-b5eb-43d2-9b89-de620ea514d9b98fd154-fd9a-4db6-b673-eddcd4007b14faad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b98fd154-fd9a-4db6-b673-eddcd4007b14</b:FlowGuid><b:Id>122</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:b98fd154-fd9a-4db6-b673-eddcd4007b14:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Authenticate user</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Authenticate user crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak has no per-client or per-IP rate limiting. Set http-max-queued-requests (no limit by default) so the server sheds load, and rate-limit by client and source IP at the reverse proxy. Run at least two nodes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>User credentials and client registration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D469efece0-b5eb-43d2-9b89-de620ea514d9b98fd154-fd9a-4db6-b673-eddcd4007b14faad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b98fd154-fd9a-4db6-b673-eddcd4007b14</b:FlowGuid><b:Id>123</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:b98fd154-fd9a-4db6-b673-eddcd4007b14:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow User credentials and client registration Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If this flow is interrupted, no code, token, or session is issued, so the login fails closed and the user starts over.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>User credentials and client registration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D569efece0-b5eb-43d2-9b89-de620ea514d9b98fd154-fd9a-4db6-b673-eddcd4007b14faad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b98fd154-fd9a-4db6-b673-eddcd4007b14</b:FlowGuid><b:Id>124</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:b98fd154-fd9a-4db6-b673-eddcd4007b14:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If the store is unavailable, logins and token requests fail closed. Availability comes from database replication and a clustered cache.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>User credentials and client registration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E669efece0-b5eb-43d2-9b89-de620ea514d9b98fd154-fd9a-4db6-b673-eddcd4007b14faad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b98fd154-fd9a-4db6-b673-eddcd4007b14</b:FlowGuid><b:Id>125</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:b98fd154-fd9a-4db6-b673-eddcd4007b14:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Authenticate user May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Keycloak database may be able to remotely execute code for Authenticate user.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The process parses parameters and tokens with standard libraries and never evaluates input as code. Keep Keycloak and its Java runtime patched and run it as an unprivileged user.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>User credentials and client registration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E769efece0-b5eb-43d2-9b89-de620ea514d9b98fd154-fd9a-4db6-b673-eddcd4007b14faad0146-5dfe-449f-a49e-d4aa6a26779b</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b98fd154-fd9a-4db6-b673-eddcd4007b14</b:FlowGuid><b:Id>126</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:b98fd154-fd9a-4db6-b673-eddcd4007b14:faad0146-5dfe-449f-a49e-d4aa6a26779b</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Authenticate user</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Authenticate user in order to change the flow of program execution within Authenticate user to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Redirect URI validation reads the client's registered URIs from this flow. Registered wildcards weaken it (RedirectUtils honors a trailing * as a prefix match), so the secure-redirect-uris-enforcer policy rejects them.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>User credentials and client registration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>faad0146-5dfe-449f-a49e-d4aa6a26779b</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S269efece0-b5eb-43d2-9b89-de620ea514d9f06d176c-c6c2-41ba-bb1f-5658919d66d9abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>f06d176c-c6c2-41ba-bb1f-5658919d66d9</b:FlowGuid><b:Id>127</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:f06d176c-c6c2-41ba-bb1f-5658919d66d9:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Issue tokens Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issue tokens may be spoofed by an attacker and this may lead to information disclosure by Keycloak database. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak reaches its database over the configured JDBC connection with a dedicated database account. Restrict that account to the Keycloak schema, require TLS with certificate validation on the JDBC URL (Keycloak does not enforce it), and keep the database on a segment only Keycloak nodes can reach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client registration and signing keys</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R669efece0-b5eb-43d2-9b89-de620ea514d9f06d176c-c6c2-41ba-bb1f-5658919d66d9abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>f06d176c-c6c2-41ba-bb1f-5658919d66d9</b:FlowGuid><b:Id>128</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:f06d176c-c6c2-41ba-bb1f-5658919d66d9:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Issue tokens</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issue tokens claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Admin events (off by default; our configuration turns them on) record client and key changes made through the admin API. Database audit logging on the Keycloak schema covers direct changes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client registration and signing keys</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D369efece0-b5eb-43d2-9b89-de620ea514d9f06d176c-c6c2-41ba-bb1f-5658919d66d9abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>f06d176c-c6c2-41ba-bb1f-5658919d66d9</b:FlowGuid><b:Id>129</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:f06d176c-c6c2-41ba-bb1f-5658919d66d9:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Issue tokens</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issue tokens crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak has no per-client or per-IP rate limiting. Set http-max-queued-requests (no limit by default) so the server sheds load, and rate-limit by client and source IP at the reverse proxy. Run at least two nodes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client registration and signing keys</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D469efece0-b5eb-43d2-9b89-de620ea514d9f06d176c-c6c2-41ba-bb1f-5658919d66d9abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>f06d176c-c6c2-41ba-bb1f-5658919d66d9</b:FlowGuid><b:Id>130</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:f06d176c-c6c2-41ba-bb1f-5658919d66d9:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Client registration and signing keys Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If this flow is interrupted, no code, token, or session is issued, so the login fails closed and the user starts over.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client registration and signing keys</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D569efece0-b5eb-43d2-9b89-de620ea514d9f06d176c-c6c2-41ba-bb1f-5658919d66d9abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>f06d176c-c6c2-41ba-bb1f-5658919d66d9</b:FlowGuid><b:Id>131</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:f06d176c-c6c2-41ba-bb1f-5658919d66d9:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If the store is unavailable, logins and token requests fail closed. Availability comes from database replication and a clustered cache.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client registration and signing keys</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E669efece0-b5eb-43d2-9b89-de620ea514d9f06d176c-c6c2-41ba-bb1f-5658919d66d9abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>f06d176c-c6c2-41ba-bb1f-5658919d66d9</b:FlowGuid><b:Id>132</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:f06d176c-c6c2-41ba-bb1f-5658919d66d9:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Issue tokens May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Keycloak database may be able to remotely execute code for Issue tokens.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Client and key configuration comes from Keycloak's own database, not from callers. The process parses parameters and tokens with standard libraries and never evaluates input as code. Keep Keycloak and its Java runtime patched and run it as an unprivileged user.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client registration and signing keys</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E769efece0-b5eb-43d2-9b89-de620ea514d9f06d176c-c6c2-41ba-bb1f-5658919d66d9abb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>f06d176c-c6c2-41ba-bb1f-5658919d66d9</b:FlowGuid><b:Id>133</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:f06d176c-c6c2-41ba-bb1f-5658919d66d9:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Issue tokens</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Issue tokens in order to change the flow of program execution within Issue tokens to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Client policies (pkce-enforcer, secure-redirect-uris-enforcer, full-scope-disabled) are read from this store, so changing them changes enforcement. Only manage-clients and manage-realm admins can change them, and admin events record the change.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client registration and signing keys</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S1abb28a11-f9b6-4a30-af74-73ce025f96ebebb2d164-0220-47aa-9f4c-8b57afb48a72845efa87-110e-4ad5-a2ea-a0a90d024814</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>ebb2d164-0220-47aa-9f4c-8b57afb48a72</b:FlowGuid><b:Id>134</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:ebb2d164-0220-47aa-9f4c-8b57afb48a72:845efa87-110e-4ad5-a2ea-a0a90d024814</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Issue tokens Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issue tokens may be spoofed by an attacker and this may lead to unauthorized access to Session store. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Only Keycloak nodes write to the session store. The session store is Keycloak's embedded Infinispan cache, persisted to the Keycloak database. Cluster traffic between nodes is TLS-encrypted by default, and nodes need the cluster certificate stored in the database to join.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client session update</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T18abb28a11-f9b6-4a30-af74-73ce025f96ebebb2d164-0220-47aa-9f4c-8b57afb48a72845efa87-110e-4ad5-a2ea-a0a90d024814</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>ebb2d164-0220-47aa-9f4c-8b57afb48a72</b:FlowGuid><b:Id>135</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:ebb2d164-0220-47aa-9f4c-8b57afb48a72:845efa87-110e-4ad5-a2ea-a0a90d024814</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>The Session store Data Store Could Be Corrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Client session update may be tampered with by an attacker. This may lead to corruption of Session store. Ensure the integrity of the data flow to the data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>This record holds the latest refresh token ID and reuse count that rotation depends on; altering it would let a spent refresh token through. Access to the cache and database is limited to Keycloak nodes. CVE-2026-9802 showed rotation state could be lost across a restart with persistent sessions, so stay patched.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client session update</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R8abb28a11-f9b6-4a30-af74-73ce025f96ebebb2d164-0220-47aa-9f4c-8b57afb48a72845efa87-110e-4ad5-a2ea-a0a90d024814</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>ebb2d164-0220-47aa-9f4c-8b57afb48a72</b:FlowGuid><b:Id>136</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:ebb2d164-0220-47aa-9f4c-8b57afb48a72:845efa87-110e-4ad5-a2ea-a0a90d024814</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Denies Session store Potentially Writing Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Session store claims that it did not write data received from an entity on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Writes happen inside Keycloak as part of the request. Failures surface as server errors and error events. REFRESH_TOKEN events record each refresh.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client session update</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6abb28a11-f9b6-4a30-af74-73ce025f96ebebb2d164-0220-47aa-9f4c-8b57afb48a72845efa87-110e-4ad5-a2ea-a0a90d024814</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>ebb2d164-0220-47aa-9f4c-8b57afb48a72</b:FlowGuid><b:Id>137</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:ebb2d164-0220-47aa-9f4c-8b57afb48a72:845efa87-110e-4ad5-a2ea-a0a90d024814</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Client session update may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Cache replication is TLS-encrypted by default; the JDBC connection needs TLS, which our deployment requires.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client session update</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4abb28a11-f9b6-4a30-af74-73ce025f96ebebb2d164-0220-47aa-9f4c-8b57afb48a72845efa87-110e-4ad5-a2ea-a0a90d024814</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>ebb2d164-0220-47aa-9f4c-8b57afb48a72</b:FlowGuid><b:Id>138</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:ebb2d164-0220-47aa-9f4c-8b57afb48a72:845efa87-110e-4ad5-a2ea-a0a90d024814</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Client session update Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If the update is lost, the next refresh fails closed and the client logs in again.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client session update</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5abb28a11-f9b6-4a30-af74-73ce025f96ebebb2d164-0220-47aa-9f4c-8b57afb48a72845efa87-110e-4ad5-a2ea-a0a90d024814</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>ebb2d164-0220-47aa-9f4c-8b57afb48a72</b:FlowGuid><b:Id>139</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:ebb2d164-0220-47aa-9f4c-8b57afb48a72:845efa87-110e-4ad5-a2ea-a0a90d024814</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If the store is unavailable, logins and token requests fail closed. Availability comes from database replication and a clustered cache.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Client session update</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S1078cb915-58f8-45a4-81e1-ec4581c8944f1d29761c-e4c6-4477-93f7-3c96a4899b8f72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>1d29761c-e4c6-4477-93f7-3c96a4899b8f</b:FlowGuid><b:Id>140</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:1d29761c-e4c6-4477-93f7-3c96a4899b8f:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Broker external login Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Broker external login may be spoofed by an attacker and this may lead to unauthorized access to Event store. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak reaches its database over the configured JDBC connection with a dedicated database account. Restrict that account to the Keycloak schema, require TLS with certificate validation on the JDBC URL (Keycloak does not enforce it), and keep the database on a segment only Keycloak nodes can reach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T18078cb915-58f8-45a4-81e1-ec4581c8944f1d29761c-e4c6-4477-93f7-3c96a4899b8f72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>1d29761c-e4c6-4477-93f7-3c96a4899b8f</b:FlowGuid><b:Id>141</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:1d29761c-e4c6-4477-93f7-3c96a4899b8f:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>The Event store Data Store Could Be Corrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Broker login events may be tampered with by an attacker. This may lead to corruption of Event store. Ensure the integrity of the data flow to the data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak's event table is not tamper-evident; anyone with database write access can change it. Forward events to an append-only SIEM so the copy outside Keycloak is the record.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R8078cb915-58f8-45a4-81e1-ec4581c8944f1d29761c-e4c6-4477-93f7-3c96a4899b8f72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>1d29761c-e4c6-4477-93f7-3c96a4899b8f</b:FlowGuid><b:Id>142</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:1d29761c-e4c6-4477-93f7-3c96a4899b8f:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Denies Event store Potentially Writing Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Event store claims that it did not write data received from an entity on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Writes happen inside Keycloak as part of the request. Failures surface as server errors and error events.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6078cb915-58f8-45a4-81e1-ec4581c8944f1d29761c-e4c6-4477-93f7-3c96a4899b8f72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>1d29761c-e4c6-4477-93f7-3c96a4899b8f</b:FlowGuid><b:Id>143</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:1d29761c-e4c6-4477-93f7-3c96a4899b8f:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Broker login events may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Broker events carry usernames, IP addresses and provider aliases, not assertions. The JDBC connection still needs TLS, which our deployment requires.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4078cb915-58f8-45a4-81e1-ec4581c8944f1d29761c-e4c6-4477-93f7-3c96a4899b8f72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>1d29761c-e4c6-4477-93f7-3c96a4899b8f</b:FlowGuid><b:Id>144</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:1d29761c-e4c6-4477-93f7-3c96a4899b8f:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Broker login events Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The default jboss-logging listener still writes events to the server log if the database write path is interrupted; forward that log to the SIEM.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5078cb915-58f8-45a4-81e1-ec4581c8944f1d29761c-e4c6-4477-93f7-3c96a4899b8f72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>1d29761c-e4c6-4477-93f7-3c96a4899b8f</b:FlowGuid><b:Id>145</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:1d29761c-e4c6-4477-93f7-3c96a4899b8f:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If the store is unavailable, logins and token requests fail closed. Availability comes from database replication and a clustered cache.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Broker login events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S1078cb915-58f8-45a4-81e1-ec4581c8944f4250e26d-d8bd-4adb-a934-39af5cb2720c69efece0-b5eb-43d2-9b89-de620ea514d9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4250e26d-d8bd-4adb-a934-39af5cb2720c</b:FlowGuid><b:Id>146</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:4250e26d-d8bd-4adb-a934-39af5cb2720c:69efece0-b5eb-43d2-9b89-de620ea514d9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Broker external login Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Broker external login may be spoofed by an attacker and this may lead to unauthorized access to Keycloak database. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak reaches its database over the configured JDBC connection with a dedicated database account. Restrict that account to the Keycloak schema, require TLS with certificate validation on the JDBC URL (Keycloak does not enforce it), and keep the database on a segment only Keycloak nodes can reach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Brokered user, identity link, and mapped roles</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T18078cb915-58f8-45a4-81e1-ec4581c8944f4250e26d-d8bd-4adb-a934-39af5cb2720c69efece0-b5eb-43d2-9b89-de620ea514d9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4250e26d-d8bd-4adb-a934-39af5cb2720c</b:FlowGuid><b:Id>147</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:4250e26d-d8bd-4adb-a934-39af5cb2720c:69efece0-b5eb-43d2-9b89-de620ea514d9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>The Keycloak database Data Store Could Be Corrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Brokered user, identity link, and mapped roles may be tampered with by an attacker. This may lead to corruption of Keycloak database. Ensure the integrity of the data flow to the data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Role assignments written here decide finance and payroll access. Force sync mode removes roles the assertion no longer supports, and only the Keycloak database account can write to the store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Brokered user, identity link, and mapped roles</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R8078cb915-58f8-45a4-81e1-ec4581c8944f4250e26d-d8bd-4adb-a934-39af5cb2720c69efece0-b5eb-43d2-9b89-de620ea514d9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4250e26d-d8bd-4adb-a934-39af5cb2720c</b:FlowGuid><b:Id>148</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:4250e26d-d8bd-4adb-a934-39af5cb2720c:69efece0-b5eb-43d2-9b89-de620ea514d9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Denies Keycloak database Potentially Writing Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Keycloak database claims that it did not write data received from an entity on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Mappers call grantRole directly and emit no event, and admin events only cover Admin REST API calls, so the store has no record of which assertion produced a role grant.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Brokered user, identity link, and mapped roles</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6078cb915-58f8-45a4-81e1-ec4581c8944f4250e26d-d8bd-4adb-a934-39af5cb2720c69efece0-b5eb-43d2-9b89-de620ea514d9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4250e26d-d8bd-4adb-a934-39af5cb2720c</b:FlowGuid><b:Id>149</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:4250e26d-d8bd-4adb-a934-39af5cb2720c:69efece0-b5eb-43d2-9b89-de620ea514d9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Brokered user, identity link, and mapped roles may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The JDBC connection needs TLS, which Keycloak does not enforce; our deployment requires it.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Brokered user, identity link, and mapped roles</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4078cb915-58f8-45a4-81e1-ec4581c8944f4250e26d-d8bd-4adb-a934-39af5cb2720c69efece0-b5eb-43d2-9b89-de620ea514d9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4250e26d-d8bd-4adb-a934-39af5cb2720c</b:FlowGuid><b:Id>150</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:4250e26d-d8bd-4adb-a934-39af5cb2720c:69efece0-b5eb-43d2-9b89-de620ea514d9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Brokered user, identity link, and mapped roles Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If this flow is interrupted, no code, token, or session is issued, so the login fails closed and the user starts over.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Brokered user, identity link, and mapped roles</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5078cb915-58f8-45a4-81e1-ec4581c8944f4250e26d-d8bd-4adb-a934-39af5cb2720c69efece0-b5eb-43d2-9b89-de620ea514d9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>4250e26d-d8bd-4adb-a934-39af5cb2720c</b:FlowGuid><b:Id>151</b:Id><b:InteractionKey>078cb915-58f8-45a4-81e1-ec4581c8944f:4250e26d-d8bd-4adb-a934-39af5cb2720c:69efece0-b5eb-43d2-9b89-de620ea514d9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If the store is unavailable, logins and token requests fail closed. Availability comes from database replication and a clustered cache.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Brokered user, identity link, and mapped roles</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S2845efa87-110e-4ad5-a2ea-a0a90d024814b36ca88a-a70d-4491-9da2-1982de6cb55eabb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b36ca88a-a70d-4491-9da2-1982de6cb55e</b:FlowGuid><b:Id>152</b:Id><b:InteractionKey>845efa87-110e-4ad5-a2ea-a0a90d024814:b36ca88a-a70d-4491-9da2-1982de6cb55e:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Issue tokens Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issue tokens may be spoofed by an attacker and this may lead to information disclosure by Session store. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Only Keycloak nodes can read the session store. The session store is Keycloak's embedded Infinispan cache, persisted to the Keycloak database. Cluster traffic between nodes is TLS-encrypted by default, and nodes need the cluster certificate stored in the database to join.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Code record and client session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6845efa87-110e-4ad5-a2ea-a0a90d024814b36ca88a-a70d-4491-9da2-1982de6cb55eabb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b36ca88a-a70d-4491-9da2-1982de6cb55e</b:FlowGuid><b:Id>153</b:Id><b:InteractionKey>845efa87-110e-4ad5-a2ea-a0a90d024814:b36ca88a-a70d-4491-9da2-1982de6cb55e:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Issue tokens</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issue tokens claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Failed redemptions are recorded as CODE_TO_TOKEN_ERROR events (invalid code). When a code is reused, Keycloak also detaches the client session created by the first redemption. Save events is off by default and only error events reach the server log, so our configuration turns it on and forwards events to the SIEM.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Code record and client session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3845efa87-110e-4ad5-a2ea-a0a90d024814b36ca88a-a70d-4491-9da2-1982de6cb55eabb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b36ca88a-a70d-4491-9da2-1982de6cb55e</b:FlowGuid><b:Id>154</b:Id><b:InteractionKey>845efa87-110e-4ad5-a2ea-a0a90d024814:b36ca88a-a70d-4491-9da2-1982de6cb55e:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Issue tokens</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issue tokens crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak has no per-client or per-IP rate limiting. Set http-max-queued-requests (no limit by default) so the server sheds load, and rate-limit by client and source IP at the reverse proxy. Run at least two nodes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Code record and client session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4845efa87-110e-4ad5-a2ea-a0a90d024814b36ca88a-a70d-4491-9da2-1982de6cb55eabb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b36ca88a-a70d-4491-9da2-1982de6cb55e</b:FlowGuid><b:Id>155</b:Id><b:InteractionKey>845efa87-110e-4ad5-a2ea-a0a90d024814:b36ca88a-a70d-4491-9da2-1982de6cb55e:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Code record and client session Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If this flow is interrupted, no code, token, or session is issued, so the login fails closed and the user starts over.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Code record and client session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5845efa87-110e-4ad5-a2ea-a0a90d024814b36ca88a-a70d-4491-9da2-1982de6cb55eabb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b36ca88a-a70d-4491-9da2-1982de6cb55e</b:FlowGuid><b:Id>156</b:Id><b:InteractionKey>845efa87-110e-4ad5-a2ea-a0a90d024814:b36ca88a-a70d-4491-9da2-1982de6cb55e:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If the store is unavailable, logins and token requests fail closed. Availability comes from database replication and a clustered cache.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Code record and client session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6845efa87-110e-4ad5-a2ea-a0a90d024814b36ca88a-a70d-4491-9da2-1982de6cb55eabb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b36ca88a-a70d-4491-9da2-1982de6cb55e</b:FlowGuid><b:Id>157</b:Id><b:InteractionKey>845efa87-110e-4ad5-a2ea-a0a90d024814:b36ca88a-a70d-4491-9da2-1982de6cb55e:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Issue tokens May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Session store may be able to remotely execute code for Issue tokens.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The code record comes from Keycloak's own store, not from the client. The process parses parameters and tokens with standard libraries and never evaluates input as code. Keep Keycloak and its Java runtime patched and run it as an unprivileged user.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Code record and client session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7845efa87-110e-4ad5-a2ea-a0a90d024814b36ca88a-a70d-4491-9da2-1982de6cb55eabb28a11-f9b6-4a30-af74-73ce025f96eb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>b36ca88a-a70d-4491-9da2-1982de6cb55e</b:FlowGuid><b:Id>158</b:Id><b:InteractionKey>845efa87-110e-4ad5-a2ea-a0a90d024814:b36ca88a-a70d-4491-9da2-1982de6cb55e:abb28a11-f9b6-4a30-af74-73ce025f96eb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Issue tokens</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Issue tokens in order to change the flow of program execution within Issue tokens to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Issue tokens validates the code record (expiry, client, redirect URI, PKCE) before issuing tokens, so altered or missing fields stop the grant.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Code record and client session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>845efa87-110e-4ad5-a2ea-a0a90d024814</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S269efece0-b5eb-43d2-9b89-de620ea514d968315d65-888b-4581-8cae-ef6f646fc622078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>68315d65-888b-4581-8cae-ef6f646fc622</b:FlowGuid><b:Id>159</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:68315d65-888b-4581-8cae-ef6f646fc622:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Broker external login Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Broker external login may be spoofed by an attacker and this may lead to information disclosure by Keycloak database. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak reaches its database over the configured JDBC connection with a dedicated database account. Restrict that account to the Keycloak schema, require TLS with certificate validation on the JDBC URL (Keycloak does not enforce it), and keep the database on a segment only Keycloak nodes can reach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Identity provider configuration and mappers</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R669efece0-b5eb-43d2-9b89-de620ea514d968315d65-888b-4581-8cae-ef6f646fc622078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>68315d65-888b-4581-8cae-ef6f646fc622</b:FlowGuid><b:Id>160</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:68315d65-888b-4581-8cae-ef6f646fc622:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Broker external login</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Broker external login claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Admin events (off by default; our configuration turns them on, with representations) record provider and mapper changes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Identity provider configuration and mappers</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D369efece0-b5eb-43d2-9b89-de620ea514d968315d65-888b-4581-8cae-ef6f646fc622078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>68315d65-888b-4581-8cae-ef6f646fc622</b:FlowGuid><b:Id>161</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:68315d65-888b-4581-8cae-ef6f646fc622:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Broker external login</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Broker external login crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak has no per-client or per-IP rate limiting. Set http-max-queued-requests (no limit by default) so the server sheds load, and rate-limit by client and source IP at the reverse proxy. Run at least two nodes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Identity provider configuration and mappers</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D469efece0-b5eb-43d2-9b89-de620ea514d968315d65-888b-4581-8cae-ef6f646fc622078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>68315d65-888b-4581-8cae-ef6f646fc622</b:FlowGuid><b:Id>162</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:68315d65-888b-4581-8cae-ef6f646fc622:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Identity provider configuration and mappers Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If this flow is interrupted, no code, token, or session is issued, so the login fails closed and the user starts over.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Identity provider configuration and mappers</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D569efece0-b5eb-43d2-9b89-de620ea514d968315d65-888b-4581-8cae-ef6f646fc622078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>68315d65-888b-4581-8cae-ef6f646fc622</b:FlowGuid><b:Id>163</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:68315d65-888b-4581-8cae-ef6f646fc622:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If the store is unavailable, logins and token requests fail closed. Availability comes from database replication and a clustered cache.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Identity provider configuration and mappers</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E669efece0-b5eb-43d2-9b89-de620ea514d968315d65-888b-4581-8cae-ef6f646fc622078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>68315d65-888b-4581-8cae-ef6f646fc622</b:FlowGuid><b:Id>164</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:68315d65-888b-4581-8cae-ef6f646fc622:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Broker external login May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Keycloak database may be able to remotely execute code for Broker external login.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Provider settings come from Keycloak's own database, not the partner. The process parses parameters and tokens with standard libraries and never evaluates input as code. Keep Keycloak and its Java runtime patched and run it as an unprivileged user.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Identity provider configuration and mappers</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E769efece0-b5eb-43d2-9b89-de620ea514d968315d65-888b-4581-8cae-ef6f646fc622078cb915-58f8-45a4-81e1-ec4581c8944f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>68315d65-888b-4581-8cae-ef6f646fc622</b:FlowGuid><b:Id>165</b:Id><b:InteractionKey>69efece0-b5eb-43d2-9b89-de620ea514d9:68315d65-888b-4581-8cae-ef6f646fc622:078cb915-58f8-45a4-81e1-ec4581c8944f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Broker external login</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Broker external login in order to change the flow of program execution within Broker external login to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Validate Signature, Identity Provider Entity ID, Sync Mode and Allow granting admin roles via mappers are read from this store. Only manage-realm can enable admin-role mapping (26.8.0), and admin events record changes to the rest.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Identity provider configuration and mappers</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>69efece0-b5eb-43d2-9b89-de620ea514d9</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>078cb915-58f8-45a4-81e1-ec4581c8944f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S1abb28a11-f9b6-4a30-af74-73ce025f96eb6ebc3649-214e-475d-9ce7-1f801c80aa6b72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>6ebc3649-214e-475d-9ce7-1f801c80aa6b</b:FlowGuid><b:Id>166</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:6ebc3649-214e-475d-9ce7-1f801c80aa6b:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Issue tokens Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issue tokens may be spoofed by an attacker and this may lead to unauthorized access to Event store. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak reaches its database over the configured JDBC connection with a dedicated database account. Restrict that account to the Keycloak schema, require TLS with certificate validation on the JDBC URL (Keycloak does not enforce it), and keep the database on a segment only Keycloak nodes can reach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T18abb28a11-f9b6-4a30-af74-73ce025f96eb6ebc3649-214e-475d-9ce7-1f801c80aa6b72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>6ebc3649-214e-475d-9ce7-1f801c80aa6b</b:FlowGuid><b:Id>167</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:6ebc3649-214e-475d-9ce7-1f801c80aa6b:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>The Event store Data Store Could Be Corrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Token events may be tampered with by an attacker. This may lead to corruption of Event store. Ensure the integrity of the data flow to the data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Keycloak's event table is not tamper-evident; anyone with database write access can change it. Forward events to an append-only SIEM so the copy outside Keycloak is the record.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R8abb28a11-f9b6-4a30-af74-73ce025f96eb6ebc3649-214e-475d-9ce7-1f801c80aa6b72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>6ebc3649-214e-475d-9ce7-1f801c80aa6b</b:FlowGuid><b:Id>168</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:6ebc3649-214e-475d-9ce7-1f801c80aa6b:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Denies Event store Potentially Writing Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Event store claims that it did not write data received from an entity on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Writes happen inside Keycloak as part of the request. Failures surface as server errors and error events.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6abb28a11-f9b6-4a30-af74-73ce025f96eb6ebc3649-214e-475d-9ce7-1f801c80aa6b72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>6ebc3649-214e-475d-9ce7-1f801c80aa6b</b:FlowGuid><b:Id>169</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:6ebc3649-214e-475d-9ce7-1f801c80aa6b:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Token events may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Events carry usernames, IP addresses and token IDs, not token values. The JDBC connection still needs TLS, which our deployment requires.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4abb28a11-f9b6-4a30-af74-73ce025f96eb6ebc3649-214e-475d-9ce7-1f801c80aa6b72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>6ebc3649-214e-475d-9ce7-1f801c80aa6b</b:FlowGuid><b:Id>170</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:6ebc3649-214e-475d-9ce7-1f801c80aa6b:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Token events Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The default jboss-logging listener still writes events to the server log if the database write path is interrupted; forward that log to the SIEM.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5abb28a11-f9b6-4a30-af74-73ce025f96eb6ebc3649-214e-475d-9ce7-1f801c80aa6b72258f16-1dde-4b0f-9f88-84893920ba9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>92a29e55-69fd-4b1f-a6ef-2cec34203314</b:DrawingSurfaceGuid><b:FlowGuid>6ebc3649-214e-475d-9ce7-1f801c80aa6b</b:FlowGuid><b:Id>171</b:Id><b:InteractionKey>abb28a11-f9b6-4a30-af74-73ce025f96eb:6ebc3649-214e-475d-9ce7-1f801c80aa6b:72258f16-1dde-4b0f-9f88-84893920ba9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-11-10T18:45:00-06:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>If the store is unavailable, logins and token requests fail closed. Availability comes from database replication and a clustered cache.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Token events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>abb28a11-f9b6-4a30-af74-73ce025f96eb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72258f16-1dde-4b0f-9f88-84893920ba9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB></ThreatInstances><ThreatGenerationEnabled>true</ThreatGenerationEnabled><Validations xmlns:a="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"/><Version>4.3</Version><KnowledgeBase z:Id="i31" xmlns:a="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase" xmlns:z="http://schemas.microsoft.com/2003/10/Serialization/"><a:GenericElements><a:ElementType><a:IsExtension>false</a:IsExtension><a:Attributes><a:Attribute><a:IsExtension>false</a:IsExtension><a:AttributeValues xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.Interfaces"><b:Value>Not Selected</b:Value><b:Value>Managed</b:Value><b:Value>Unmanaged</b:Value></a:AttributeValues><a:DisplayName>Code Type</a:DisplayName><a:Inheritance>Virtual</a:Inheritance><a:Mode>Dynamic</a:Mode><a:Name>codeType</a:Name><a:Type>List</a:Type></a:Attribute><a:Attribute><a:IsExtension>false</a:IsExtension><a:AttributeValues xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.Interfaces"><b:Value>Not Selected</b:Value><b:Value>Kernel</b:Value><b:Value>System</b:Value><b:Value>Network Service</b:Value><b:Value>Local Service</b:Value><b:Value>Administrator</b:Value><b:Value>Standard User With Elevation</b:Value><b:Value>Standard User Without Elevation</